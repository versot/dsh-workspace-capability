{
  "name": "dsh-workspace-skill-scope",
  "version": "1.0.0",
  "description": "Per-workspace Skill and whole-MCP-server visibility for DeepSeek Harness, with child-Agent scope narrowing.",
  "license": "MIT",
  "author": "versot",
  "homepage": "https://github.com/versot/dsh-workspace-skill-scope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versot/dsh-workspace-skill-scope.git"
  },
  "bugs": {
    "url": "https://github.com/versot/dsh-workspace-skill-scope/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "mcp",
    "workspace",
    "cordis"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./provider": "./provider.js",
    "./client": "./client.js",
    "./catalog": "./catalog.js",
    "./mcp-scope": "./mcp-scope.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "provider.js",
    "catalog.js",
    "client.js",
    "filter.js",
    "agent-scopes.js",
    "mcp-scope.js",
    "cordis.patch.yml",
    "docs/*.md",
    "locale/*.json",
    "icon.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && node scripts/check.mjs",
    "pack": "npm pack"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
